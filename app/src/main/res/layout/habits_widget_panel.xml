<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habits_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/habits_widget_background_light">
    <TextView android:id="@+id/habits_widget_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Habits" android:textSize="20sp" android:textStyle="bold"
        android:textColor="#22231F" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/habits_widget_summary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="#66685F"
        android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/habits_widget_empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Open app" android:textSize="15sp"
        android:textColor="#22231F" android:maxLines="3" android:ellipsize="end" />
    <LinearLayout android:id="@+id/habits_widget_row_1"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="6dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/habits_widget_item_title_1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#22231F" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/habits_widget_item_detail_1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#66685F" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <Button android:id="@+id/habits_widget_action_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:minWidth="68dp" android:minHeight="48dp" android:padding="8dp"
            android:textSize="12sp" android:textAllCaps="false" android:textColor="#294CC7"
            android:background="@drawable/habits_widget_action_light" />
    </LinearLayout>
    <LinearLayout android:id="@+id/habits_widget_row_2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="6dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/habits_widget_item_title_2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#22231F" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/habits_widget_item_detail_2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#66685F" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <Button android:id="@+id/habits_widget_action_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:minWidth="68dp" android:minHeight="48dp" android:padding="8dp"
            android:textSize="12sp" android:textAllCaps="false" android:textColor="#294CC7"
            android:background="@drawable/habits_widget_action_light" />
    </LinearLayout>
    <LinearLayout android:id="@+id/habits_widget_row_3"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="6dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/habits_widget_item_title_3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#22231F" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/habits_widget_item_detail_3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#66685F" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <Button android:id="@+id/habits_widget_action_3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:minWidth="68dp" android:minHeight="48dp" android:padding="8dp"
            android:textSize="12sp" android:textAllCaps="false" android:textColor="#294CC7"
            android:background="@drawable/habits_widget_action_light" />
    </LinearLayout>
    <TextView android:id="@+id/habits_widget_updated"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="11sp" android:textColor="#66685F"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
